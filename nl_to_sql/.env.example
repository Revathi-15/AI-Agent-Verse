# Copy this file to .env and fill in your values

# ── LLM Provider ───────────────────────────────────────────────────────────
# Options: openai | claude | gemini
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
CLAUDE_API_KEY=sk-ant-...
GEMINI_API_KEY=...

# ── Database ────────────────────────────────────────────────────────────────
SQLITE_DB=sqlite.db

# Optional: PostgreSQL for conversation history
POSTGRES_URL=postgresql://user:password@host:5432/dbname

# Optional: MySQL live connection
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=
MYSQL_POOL_SIZE=5
MYSQL_POOL_TIMEOUT=30

# ── Google Sheets ───────────────────────────────────────────────────────────
GOOGLE_SHEETS_ENABLED=true
# Place google_service_account.json in nl_to_sql/ folder

# ── Email (SMTP) ────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=your_email@gmail.com

# ── Slack ───────────────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-...
SLACK_DEFAULT_CHANNEL=#data-reports

# ── Vector DB ───────────────────────────────────────────────────────────────
VECTOR_DB_PROVIDER=local
PINECONE_API_KEY=
PINECONE_INDEX=nl-to-sql-history

# ── Voice (Whisper) ─────────────────────────────────────────────────────────
WHISPER_MODEL=whisper-1

# ── User Permissions ────────────────────────────────────────────────────────
DEFAULT_ROLE=admin
